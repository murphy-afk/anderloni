# Copy this file to server/.env and fill in real values.
# The .env file is git ignored.

# MySQL connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/anderloni"

# Express server port.
PORT=4000

# Origin allowed by CORS during development.
CLIENT_ORIGIN="http://localhost:5173"
