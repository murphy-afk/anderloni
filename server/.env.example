# Copy this file to server/.env and fill in real values.
# The .env file is git ignored.

# MySQL connection used by Prisma and the API.
DB_USER=...
DB_PASSWORD=...
DB_HOST=localhost
DB_PORT=3306
DB_NAME=anderloni

# Express server port.
PORT=4000

# Origin allowed by CORS during development.
CLIENT_ORIGIN=http://localhost:5173
